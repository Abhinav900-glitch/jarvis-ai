# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Every key is prefixed LIVE_ (see app/config.py).
#
#   cp env.example .env
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
LIVE_HOST=127.0.0.1
LIVE_PORT=8787
# Add your Vite origin so the browser can open the socket.
LIVE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LIVE_LOG_LEVEL=INFO

# --- speech-to-text ---------------------------------------------------------
# tiny | base | small | medium | large-v3  (or a path to a downloaded model)
# "base" is the sweet spot on CPU; use "small" or "large-v3" on a GPU.
LIVE_STT_MODEL=base
LIVE_STT_COMPUTE_TYPE=int8
LIVE_STT_DEVICE=cpu
LIVE_STT_BEAM_SIZE=1

# --- text-to-speech ---------------------------------------------------------
# piper | kokoro | none
LIVE_TTS_BACKEND=piper
LIVE_TTS_MODEL=en_US-amy-medium
LIVE_TTS_DATA_DIR=~/.local/share/piper-voices
LIVE_TTS_SAMPLE_RATE=24000
LIVE_TTS_SPEED=1.0

# --- local LLM --------------------------------------------------------------
# Any OpenAI-compatible server on localhost. See README for llama.cpp / Ollama.
LIVE_LLM_BASE_URL=http://127.0.0.1:8080/v1
LIVE_LLM_MODEL=local-model
LIVE_LLM_API_KEY=not-needed
LIVE_LLM_TEMPERATURE=0.6
LIVE_LLM_MAX_TOKENS=512
LIVE_LLM_CONTEXT_MESSAGES=12
# Set a vision-capable model id to enable camera frames, e.g. qwen2-vl.
LIVE_LLM_VISION_MODEL=
LIVE_LLM_VISION_INTERVAL=0.5

# --- vision -----------------------------------------------------------------
LIVE_VISION_ENABLED=true
LIVE_VISION_MAX_FRAMES=2
LIVE_VISION_MAX_EDGE=768

# --- voice activity detection ------------------------------------------------
# silero | energy  (falls back to energy automatically if silero is missing)
LIVE_VAD_BACKEND=silero
LIVE_VAD_THRESHOLD=0.5
LIVE_VAD_MIN_SPEECH_MS=200
LIVE_VAD_MIN_SILENCE_MS=500
# Grace period before barge-in arms, stops the assistant interrupting itself.
LIVE_VAD_BARGE_IN_DELAY_MS=240

# --- runtime -----------------------------------------------------------------
LIVE_PRELOAD_MODELS=true
LIVE_MAX_AUDIO_BUFFER_BYTES=4194304
